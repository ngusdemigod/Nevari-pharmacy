<?xml version="1.0"?>
<ruleset name="Nevari Checkout">
    <description>WordPress and PHP 7.4 compatibility checks for production PHP.</description>
    <file>nevari-checkout.php</file>
    <file>includes/elementor</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>
</ruleset>
